{
  "name": "Resultado de portabilidad - receptor Claro",
  "request": {
    "method": "POST",
    "urlPath": "/receptor/portability-result",
    "headers": {
      "X-Operador-Receptor": {
        "equalTo": "Claro"
      },
      "Content-Type": {
        "contains": "application/json"
      }
    },
    "bodyPatterns": [
      {
        "matchesJsonPath": "$.request_id"
      },
      {
        "matchesJsonPath": "$.msisdn"
      },
      {
        "matchesJsonPath": "$.operador_donante"
      },
      {
        "matchesJsonPath": {
          "expression": "$.operador_receptor",
          "equalTo": "Claro"
        }
      },
      {
        "matchesJsonPath": "$.fecha_finalizacion"
      },
      {
        "matchesJsonPath": {
          "expression": "$.estado",
          "matches": "COMPLETED|REJECTED"
        }
      }
    ]
  },
  "response": {
    "status": 200,
    "headers": {
      "Content-Type": "application/json"
    },
    "jsonBody": {
      "request_id": "{{jsonPath request.body '$.request_id'}}",
      "estado": "RECIBIDO"
    },
    "transformers": [
      "response-template"
    ]
  }
}
